# ==============================================================================
# THUNA Environment Configuration (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Copy this file to '.env' for local development or production configuration.
# - NEVER commit actual credentials, API keys, or '.env' files to the Git repository.
# - The '.env' file is strictly excluded by .gitignore.
# - All keys defined here are used exclusively on the server and are NEVER exposed to the frontend.
# ==============================================================================

# --- Core Django Settings ---
# Generate a strong, unique secret key in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-50-characters

# Set to False in production
DEBUG=True

# Comma-separated list of hostnames/IPs this app can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database & Cache Configuration ---
# Supports SQLite (sqlite:///path/to/db.sqlite3) or standard engine credentials
DATABASE_URL=sqlite:///db.sqlite3

# Redis broker/backend URL (used by Celery for asynchronous background jobs)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# --- File Processing Limits ---
# Maximum upload size in bytes (e.g. 524288000 = 500 MB)
MAX_UPLOAD_SIZE=524288000
MAX_IMAGE_PIXELS=120000000
MAX_VIDEO_DURATION=3600
MAX_ARCHIVE_SIZE=524288000
MAX_EXTRACTED_SIZE=1048576000
MAX_ARCHIVE_FILES=2000
CONVERSION_TIMEOUT=120

# Optional temporary workspace directory path for file transformations
# CONVERSION_TMP_ROOT=C:\Temp\thuna-conversions

# --- External Binary Paths (Optional overrides) ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
LIBREOFFICE_BINARY=libreoffice
TESSERACT_BINARY=tesseract
